<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (night). -->
    <style name="Base.Theme.BrainyneamProject" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->


        <!-- APP BACKGROUND
             yaha se change hoga  -->

        <item name="android:windowBackground">@color/night_app_background</item>


    </style>

    <style name="Theme.BrainyneamProject" parent="Base.Theme.BrainyneamProject" />



    <style name="AppTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/Color_Night_Title</item>
        <item name="android:layout_marginBottom">70dp</item>
    </style>


    <style name="AppSubtitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginBottom">50dp</item>
    </style>


    <style name="AppEditText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:textColorHint">@color/night_input_box_hint_color</item>
        <item name="android:padding">15dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:background">@drawable/custom_inputBox_color</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppLink">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/Color_Night_Links</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>