<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppPage"
    android:id="@+id/main"
    tools:context=".Signup_Page">

    <TextView
        style="@style/AppTitle"
        android:text="Create Account"
        android:textSize="30sp" />

    <TextView
        style="@style/AppSubtitle"
        android:text=" Create Account For Using this app " />

    <EditText
        android:id="@+id/Name"
        style="@style/AppEditText"
        android:hint="Name"
        android:inputType="textPersonName"
        android:drawableStart="@drawable/user_svgrepo_com" />

    <EditText
        android:id="@+id/Contact"
        style="@style/AppEditText"
        android:hint="Contact Number"
        android:inputType="phone"
        android:drawableStart="@drawable/phone_svgrepo_com" />

    <EditText
        android:id="@+id/email"
        style="@style/AppEditText"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:drawableStart="@drawable/email_svgrepo_com" />

    <EditText
        android:id="@+id/password_new"
        style="@style/AppEditText"
        android:hint="New Password"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock_svgrepo_com" />

    <EditText
        android:id="@+id/password_confirm"
        style="@style/AppEditText"
        android:hint="Confirm Password"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock_svgrepo_com" />

    <Button
        android:id="@+id/btnSignup"
        style="@style/AppButton"
        android:text="Sign Up" />

    <TextView
        android:id="@+id/btnSignIn"
        style="@style/AppLink.Footer"
        android:text="Already Have Account ? Login Here" />

</LinearLayout>